{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agente-x",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "account_id": "ba24054eb66f1fe9d92ee007409f2615",
  "workers_dev": true,
  "d1_databases": [
    { "binding": "DB", "database_name": "agente-x", "database_id": "e40267fc-6ffe-4286-848d-c010add02bda", "migrations_dir": "migrations" }
  ],
  "vars": {
    // Client ID de Google OAuth (público). Se completa al dar de alta el login con Google.
    // Clave pública VAPID para las notificaciones push (la privada es un secreto).
    "VAPID_PUBLIC_KEY": "BP7-LejKe7yfefhdh4JmVlomlVwMJ1nmsm9_D3ilBmMPqUKvJvVmeSXiP9SgB6DfifkD__0qvGcS61PnN8TZVCI",
    "GOOGLE_CLIENT_ID": "858064675156-kqgehgnu3fb90cmtbit4pah76aij8va8.apps.googleusercontent.com"
  },
  // Revisa cada 5 minutos qué avisos mandar.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
